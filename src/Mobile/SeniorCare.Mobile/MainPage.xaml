<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SeniorCare.Mobile.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:SeniorCare.Mobile.Models"
    BackgroundColor="{StaticResource Background}">

    <Grid>
        <ScrollView x:Name="LoginView">
            <VerticalStackLayout
                Padding="28"
                Spacing="14"
                VerticalOptions="Center">
                <Border
                    Padding="22"
                    BackgroundColor="White"
                    Stroke="#DBE4EC"
                    StrokeShape="RoundRectangle 22">
                    <VerticalStackLayout Spacing="13">
                        <Border
                            WidthRequest="64"
                            HeightRequest="64"
                            BackgroundColor="{StaticResource Blue}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            HorizontalOptions="Start">
                            <Label
                                Text="SC"
                                TextColor="White"
                                FontSize="22"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <Label
                            Text="SeniorCare"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Navy}" />
                        <Label
                            Text="Aplicación operativa para administradores y cuidadores"
                            FontSize="16"
                            TextColor="#637486" />

                        <Label Text="Usuario" FontAttributes="Bold" />
                        <Entry
                            x:Name="UsernameEntry"
                            Text="cuidador"
                            Placeholder="Usuario"
                            AutomationProperties.Name="Usuario" />

                        <Label Text="Contraseña" FontAttributes="Bold" />
                        <Entry
                            x:Name="PasswordEntry"
                            IsPassword="True"
                            Placeholder="Contraseña"
                            AutomationProperties.Name="Contraseña" />

                        <Button
                            Text="Ingresar"
                            BackgroundColor="{StaticResource Blue}"
                            TextColor="White"
                            Clicked="OnLoginClicked" />

                        <Label
                            x:Name="LoginMessage"
                            TextColor="{StaticResource Red}"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            x:Name="DashboardView"
            IsVisible="False"
            RowDefinitions="Auto,*">
            <Grid
                Padding="20,18"
                ColumnDefinitions="*,Auto"
                BackgroundColor="{StaticResource Navy}">
                <VerticalStackLayout>
                    <Label
                        Text="SeniorCare"
                        TextColor="White"
                        FontSize="24"
                        FontAttributes="Bold" />
                    <Label
                        x:Name="WelcomeLabel"
                        Grid.Row="1"
                        TextColor="#C8D8E6"
                        FontSize="14" />
                </VerticalStackLayout>
                <Button
                    Grid.Column="1"
                    Text="Salir"
                    BackgroundColor="#294B68"
                    TextColor="White"
                    Clicked="OnLogoutClicked" />
            </Grid>

            <RefreshView
                x:Name="AlertsRefresh"
                Grid.Row="1"
                Refreshing="OnRefreshing">
                <ScrollView>
                    <VerticalStackLayout Padding="18" Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label
                                    Text="Alertas activas"
                                    FontSize="25"
                                    FontAttributes="Bold"
                                    TextColor="{StaticResource Navy}" />
                                <Label
                                    Text="Deslizá hacia abajo para actualizar."
                                    TextColor="#637486" />
                            </VerticalStackLayout>
                            <Border
                                Grid.Column="1"
                                Padding="13,7"
                                BackgroundColor="#FDE9EA"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14">
                                <Label
                                    x:Name="AlertCountLabel"
                                    Text="0"
                                    TextColor="{StaticResource Red}"
                                    FontSize="20"
                                    FontAttributes="Bold" />
                            </Border>
                        </Grid>

                        <Label
                            x:Name="EmptyLabel"
                            Text="No hay alertas activas."
                            Padding="18"
                            BackgroundColor="#E3F4E8"
                            TextColor="#237944"
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold" />

                        <VerticalStackLayout
                            x:Name="AlertCollection"
                            BindableLayout.ItemsSource="{Binding Alerts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:AlertItem">
                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="16"
                                        BackgroundColor="White"
                                        Stroke="#DBE4EC"
                                        StrokeShape="RoundRectangle 16">
                                        <VerticalStackLayout Spacing="8">
                                            <Label
                                                Text="{Binding TypeLabel}"
                                                TextColor="{Binding TypeColor}"
                                                FontAttributes="Bold"
                                                FontSize="13" />
                                            <Label
                                                Text="{Binding ResidentName}"
                                                FontSize="21"
                                                FontAttributes="Bold" />
                                            <Label
                                                Text="{Binding Message}"
                                                FontSize="16"
                                                TextColor="#4F6273" />
                                            <Label
                                                Text="{Binding CreatedLabel}"
                                                FontSize="13"
                                                TextColor="#718394" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Button
                                                    Text="Atender"
                                                    CommandParameter="{Binding Id}"
                                                    BackgroundColor="#A76305"
                                                    TextColor="White"
                                                    Clicked="OnAcknowledgeClicked" />
                                                <Button
                                                    Grid.Column="1"
                                                    Text="Resolver"
                                                    CommandParameter="{Binding Id}"
                                                    BackgroundColor="#237944"
                                                    TextColor="White"
                                                    Clicked="OnResolveClicked" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Label
                            Text="Videollamadas activas"
                            FontSize="22"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Navy}" />
                        <VerticalStackLayout
                            x:Name="VideoCollection"
                            BindableLayout.ItemsSource="{Binding VideoRooms}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:VideoRoom">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="14"
                                        BackgroundColor="White"
                                        Stroke="#DBE4EC"
                                        StrokeShape="RoundRectangle 14">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout>
                                                <Label
                                                    Text="{Binding ResidentName}"
                                                    FontAttributes="Bold"
                                                    FontSize="18" />
                                                <Label
                                                    Text="Solicitud de videollamada"
                                                    TextColor="#637486" />
                                            </VerticalStackLayout>
                                            <Button
                                                Grid.Column="1"
                                                Text="Unirse"
                                                CommandParameter="{Binding RoomUrl}"
                                                BackgroundColor="#7447B8"
                                                TextColor="White"
                                                Clicked="OnJoinVideoClicked" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>
        </Grid>

        <ActivityIndicator
            x:Name="BusyIndicator"
            IsVisible="False"
            IsRunning="False"
            Color="{StaticResource Blue}"
            WidthRequest="56"
            HeightRequest="56"
            HorizontalOptions="Center"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
