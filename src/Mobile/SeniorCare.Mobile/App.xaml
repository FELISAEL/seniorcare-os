<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="SeniorCare.Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Application.Resources>
        <Color x:Key="Navy">#102A43</Color>
        <Color x:Key="Blue">#176EB5</Color>
        <Color x:Key="Red">#C82D34</Color>
        <Color x:Key="Background">#F3F7FA</Color>

        <Style TargetType="Label">
            <Setter Property="TextColor" Value="#172B3D" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="MinimumHeightRequest" Value="50" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style TargetType="Entry">
            <Setter Property="MinimumHeightRequest" Value="52" />
            <Setter Property="BackgroundColor" Value="White" />
        </Style>
    </Application.Resources>
</Application>
