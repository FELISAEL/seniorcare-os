#!/usr/bin/env bash
set -euo pipefail

if ! id seniorcare >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash --comment "SeniorCare" seniorcare
fi
# Contraseña inicial de la sesión de demostración (cambiarla en producción).
echo "seniorcare:seniorcare" | chpasswd

# Escritorio de ejemplo del usuario (los lanzadores deben ser ejecutables).
install -d -o seniorcare -g seniorcare /home/seniorcare/Desktop
cp /etc/skel/Desktop/*.desktop /home/seniorcare/Desktop/
chown -R seniorcare:seniorcare /home/seniorcare/Desktop
chmod 755 /home/seniorcare/Desktop/*.desktop /etc/skel/Desktop/*.desktop

chmod 755 /usr/local/bin/seniorcare-app /usr/local/bin/seniorcare-monitor \
          /usr/local/bin/seniorcare-set-url /usr/local/lib/seniorcare/monitor.py \
          /usr/local/lib/seniorcare/trust-launchers /usr/local/lib/seniorcare/set-wallpaper

# El usuario puede cambiar la dirección del portal desde 'Configurar servidor'.
chown seniorcare:seniorcare /etc/seniorcare/kiosk.env
chmod 664 /etc/seniorcare/kiosk.env

gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
chmod 750 /usr/local/lib/seniorcare/health-check

systemctl enable lightdm.service seniorcare-health.timer NetworkManager.service

# Guest Additions de VirtualBox (portapapeles compartido y pantalla ajustable).
# Opcional: si el paquete no está disponible, la ISO se construye igual.
if DEBIAN_FRONTEND=noninteractive apt-get install -y virtualbox-guest-x11; then
  systemctl enable virtualbox-guest-utils.service || true
else
  echo "AVISO: virtualbox-guest-x11 no disponible; se omite."
fi

# Heredado del arreglo de autologin: LightDM debe poseer la pantalla (tty1).
systemctl disable getty@tty1.service
systemctl disable apt-daily.timer apt-daily-upgrade.timer
systemctl mask apt-daily.timer apt-daily-upgrade.timer

cat >/etc/issue <<'EOT'
SeniorCare OS (Debian 13 personalizado)

EOT
