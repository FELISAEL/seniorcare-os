# Los valores CAMBIAR_* son marcadores: la API se niega a iniciar con ellos.
# scripts/configurar-entorno.ps1 (o INICIAR_SENIORCARE.cmd) crea .env con secretos aleatorios.
POSTGRES_USER=seniorcare
POSTGRES_PASSWORD=CAMBIAR_CONTRASENA

JWT_SECRET=CAMBIAR_CLAVE_JWT_MINIMO_32_CARACTERES
JWT_ISSUER=SeniorCare.Identity
JWT_AUDIENCE=SeniorCare.Platform

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=CAMBIAR_CONTRASENA

SEED_CAREGIVER_USERNAME=cuidador
SEED_CAREGIVER_PASSWORD=CAMBIAR_CONTRASENA

SEED_RESIDENT_USERNAME=maria
SEED_RESIDENT_PASSWORD=CAMBIAR_CONTRASENA

SEED_FAMILY_USERNAME=ana
SEED_FAMILY_PASSWORD=CAMBIAR_CONTRASENA

VIDEO_PROVIDER_BASE_URL=https://meet.jit.si/

ETL_INTERVAL_SECONDS=30

# Confirmación de dosis: hoy y hasta N días anteriores (0-7). 1 cubre una confirmación
# hecha sin conexión antes de medianoche que llega al servidor después. Nunca fechas futuras.
DOSE_CONFIRMATION_MAX_DAYS_LATE=1

# --- Notificaciones por correo (Gmail) ---
# 1) Activa la verificacion en 2 pasos en la cuenta de Gmail.
# 2) Crea una "contraseña de aplicacion" en https://myaccount.google.com/apppasswords
# 3) Pegala en SMTP_PASSWORD (con o sin espacios) y pon SMTP_ENABLED=true.
# Este archivo es el ejemplo: la contraseña real va solo en tu .env (no se sube a git).
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=
SMTP_FROM=tu_cuenta@gmail.com
SMTP_FROM_NAME=SeniorCare


# --- Videollamadas con Jitsi alojado por 8x8 (JaaS) ---
# Guia paso a paso: docs/jaas-setup.md
# JAAS_KEY_ID: el "Key ID" completo que muestra 8x8, con la forma vpaas-magic-cookie-xxxx/yyyyyy
# JAAS_PRIVATE_KEY: el archivo de llave privada (.pk) convertido a base64 en UNA sola linea.
# Si JAAS_KEY_ID esta vacio se usa el Jitsi publico (meet.jit.si) como respaldo.
JAAS_KEY_ID=
JAAS_APP_ID=
JAAS_PRIVATE_KEY=


# --- Videollamadas con Google Meet (API) ---
# Guia paso a paso: docs/google-meet-setup.md
# Si GOOGLE_MEET_ENABLED=false (o falla Google) se usa Jitsi como respaldo.
GOOGLE_MEET_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
